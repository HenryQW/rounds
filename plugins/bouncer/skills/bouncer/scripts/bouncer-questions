#!/usr/bin/env bash
# bouncer-questions add "<TICKET> | <session_id> | <question>"   add a question for the user at the end (replaces that ticket's old one in its place);
#   the line gets " | at: <UTC time>", the time it was added, for the pane's age
# bouncer-questions next     print the head: the oldest question, the only one the user sees (exit 1 when none is open)
# bouncer-questions done <TICKET>   remove that ticket's question once the user answered (exit 1 when it has none)
# bouncer-questions list     print the open questions, oldest first
# bouncer-questions count    print the number of open questions
# The list is questions.md in this Bouncer's repo folder of the plugin's data (bouncer-data --repo); the band reads it to show each question.
# Exit 2: bad usage or a line without a ticket, a session id and a question.
set -euo pipefail
trim() { local s=$1; s=${s#"${s%%[![:space:]]*}"}; printf '%s' "${s%"${s##*[![:space:]]}"}"; }
usage() { echo "usage: bouncer-questions add|next|done|list|count [line|ticket]" >&2; exit 2; }
cmd=${1:-}
[ -n "$cmd" ] || usage
f="$("$(dirname "$0")/bouncer-data" --repo)/questions.md"
touch "$f"
# Match the ticket literally: Skill and Cleanup task names may hold regex characters.
has() { T="$1 |" awk 'index($0, ENVIRON["T"]) == 1 { f = 1 } END { exit !f }' "$f"; }
case $cmd in
  add)
    IFS='|' read -r t s q <<<"${2:-}"   # q keeps any further | of the question
    t=$(trim "$t"); s=$(trim "${s:-}"); q=$(trim "${q:-}")
    q=$(trim "$(printf '%s' "$q" | sed -E 's/ ?\| at: [^ ]+$//')")   # a given at: is replaced
    [ -n "$t" ] && [ -n "$s" ] && [ -n "$q" ] || { echo "bad line: want TICKET | session_id | question" >&2; exit 2; }
    now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    # A ticket's new question keeps the old one's place: questions block in order, so a reworded head stays the head.
    if has "$t"; then
      tmp=$(mktemp); T="$t |" N="$t | $s | $q | at: $now" awk 'index($0, ENVIRON["T"]) == 1 { print ENVIRON["N"]; next } { print }' "$f" > "$tmp"; mv "$tmp" "$f"
    else echo "$t | $s | $q | at: $now" >> "$f"; fi ;;
  next)
    [ -s "$f" ] || { echo "no open question" >&2; exit 1; }
    head -n 1 "$f" ;;
  done)
    t=$(trim "${2:-}"); [ -n "$t" ] || usage
    has "$t" || { echo "no open question for $t" >&2; exit 1; }
    tmp=$(mktemp); T="$t |" awk 'index($0, ENVIRON["T"]) != 1' "$f" > "$tmp"; mv "$tmp" "$f" ;;
  list) cat "$f" ;;
  count) grep -c . "$f" || true ;;
  *) usage ;;
esac
