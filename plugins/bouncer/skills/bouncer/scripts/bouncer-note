#!/usr/bin/env python3
"""bouncer-note [--session <local session id>]... < <turn-end note>
One call for a Bartender's turn-end note: all that the Bouncer reads before it acts on the note.
For each session that the note names ("you started (local_...) finished a turn"), and each --session:
  report: the 6 report fields as JSON (bouncer-report). The note quotes only 400 characters of the Bartender's answer;
          when the quote has no good report, the script reads that Bartender's last answer (bouncer-session last).
          "report: none (<errors>)" when neither has one.
  accept: for DONE, the bouncer-accept lines ("pass", "gap: ...", "note: ...")
  grant:  that ticket's grant line (bouncer-grants get), or none
  record: the ticket record's path, the ids of its DRAFTS, and its open ledger lines; "record: none" with no file
Then once: "questions: <n>" and "queue: <n>", each with its head line.
Exit 0. Exit 2: the note names no session and no --session is given."""
import json, os, re, subprocess, sys

HERE = os.path.dirname(os.path.realpath(__file__))

def run(script, *args, stdin=None):
    p = subprocess.run([os.path.join(HERE, script), *args], input=stdin, capture_output=True, text=True)
    return p.returncode, p.stdout.strip(), p.stderr.strip()

a, given = sys.argv[1:], []
while a:
    if a[0] == "--session" and len(a) > 1 and re.fullmatch(r"local_[\w-]+", a[1]): given.append(a[1]); a = a[2:]
    else: print("usage: bouncer-note [--session <local session id>]... < <turn-end note>", file=sys.stderr); sys.exit(2)
note = "" if sys.stdin.isatty() else sys.stdin.read()
# One part of the note for each session: from its "you started (<id>) finished a turn" to the next one.
marks = list(re.finditer(r"you started \((local_[\w-]+)\) finished a turn", note))
parts = {m.group(1): note[m.start():(marks[i + 1].start() if i + 1 < len(marks) else len(note))] for i, m in enumerate(marks)}
for s in given: parts.setdefault(s, note if not marks else "")
if not parts: print("no session: the note names none and no --session is given", file=sys.stderr); sys.exit(2)

def report(session, quote):
    code, out, _ = run("bouncer-report", stdin=quote)
    if code == 0: return json.loads(out), "note", ""
    errors = "; ".join(json.loads(out).get("error", [])) if out.startswith("{") else "no report"
    found, last, _ = run("bouncer-session", "last", session)
    if found != 0: return None, "", f"note: {errors}; last answer: not found"
    code, out, _ = run("bouncer-report", "--full", stdin=last)
    if code == 0: return json.loads(out), "last answer", ""
    return None, "", "last answer: " + ("; ".join(json.loads(out).get("error", [])) if out.startswith("{") else "no report")

def record(ticket):
    path = os.path.join(run("bouncer-ledger", "dir")[1], ticket + ".md")
    try: lines = open(path).read().splitlines()
    except OSError: return ["record: none"]
    drafts, ledger, section = [], [], ""
    for line in lines:
        head = re.match(r"^(?:#{1,2} *)?([A-Z][A-Z _-]*)\s*$", line)
        if head: section = head.group(1).strip()
        elif section == "DRAFTS" and line.startswith("### "): drafts.append(line[4:].strip())
        elif line.startswith("- [open] "): ledger.append("  " + line)
    return [f"record: {path} | drafts: {', '.join(drafts) or 'none'} | ledger open: {len(ledger)}", *ledger]

for session, quote in parts.items():
    print(f"session: {session}")
    r, source, why = report(session, quote)
    if r is None:
        print(f"report: none ({why})"); continue
    print(f"report: {json.dumps(r, ensure_ascii=False)} (from the {source})")
    ticket = r.get("ticket") or ""
    if r["status"] == "DONE":
        _, out, err = run("bouncer-accept", json.dumps(r))
        print("accept: " + " | ".join((out or err).splitlines()))
    if re.fullmatch(r"[\w.-]+", ticket) and r["status"] != "WORKING":
        print("grant: " + (run("bouncer-grants", "get", ticket)[1] or "none"))
        print("\n".join(record(ticket)))
for name, script, head in (("questions", "bouncer-questions", "next"), ("queue", "bouncer-queue", "list")):
    code, out, err = run(script, "list")
    lines = out.splitlines()
    first = run(script, head)[1].splitlines()[:1] if lines else []
    print(f"{name}: {len(lines)}" + (f" | head: {first[0]}" if first else "") if code == 0 else f"{name}: unknown ({err})")
