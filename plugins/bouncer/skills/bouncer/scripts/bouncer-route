#!/usr/bin/env python3
"""bouncer-route < {"sessions": [list_sessions rows], "request": {"ticket", "repo"}, "caps": {"active": 3}}
Out: {"action": "assign"|"start"|"queue", "sessionId"?: id, "reason": text}. Exit 2: bad input.
Rules: a Bartender title contains "🍸"; its repo is the last word of the title.
Idle: the title starts with "[Idle]" and isRunning is not true. An idle Bartender of the repo gets the ticket;
else a new Bartender starts (one per ticket, so tickets of one repo run in parallel).
At most caps.active non-idle Bartenders (default 3). Archived rows are ignored."""
import json, sys

def bad(msg):
    print(json.dumps({"error": f"bad input: {msg}"})); sys.exit(2)

try:
    d = json.load(sys.stdin)
    rows, req = d["sessions"], d["request"]
    ticket, repo = req["ticket"], req["repo"]
    active = int((d.get("caps") or {}).get("active", 3))
except (ValueError, KeyError, TypeError) as e:
    bad(e)
if not ticket or not repo or active < 1:
    bad("ticket, repo and caps.active >= 1 are required")

def idle(s):
    return (s.get("title") or "").startswith("[Idle]") and not s.get("isRunning")

bars = [s for s in rows if "🍸" in (s.get("title") or "") and not s.get("isArchived")]
here = [s for s in bars if s["title"].split()[-1] == repo]
busy = [s for s in bars if not idle(s)]
free = [s for s in here if idle(s)]
if free:
    out = {"action": "assign", "sessionId": free[0]["sessionId"], "reason": f"idle Bartender in {repo}"}
elif len(busy) >= active:
    out = {"action": "queue", "reason": f"pool full: {len(busy)} of {active} Bartenders active"}
else:
    out = {"action": "start", "reason": f"no idle Bartender in {repo}; {len(busy)} of {active} active"}
print(json.dumps(out))
