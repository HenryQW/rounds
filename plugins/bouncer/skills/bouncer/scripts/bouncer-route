#!/usr/bin/env python3
"""bouncer-route < {"sessions": [list_sessions rows], "request": {"ticket", "repo", "type"?}, "caps": {"active": 3}}
Out: {"action": "assign"|"start"|"queue", "sessionId"?: id, "reason": text}. Exit 2: bad input.
Rules: a Bartender title contains its type emoji (Ticket 🍸, the default; Skill 🔧; Cleanup 🧹).
Idle: the title is "<emoji> [Idle] <repo>" (before plugin 0.10.5 "[Idle] <emoji> <repo>") and isRunning is not true.
A current title stores the whole repo name. An old title stores its last word.
Below caps.active non-idle Bartenders (default 3), assign a free Bartender of the same type and repo if one exists.
Otherwise, start a new Bartender for the ticket. At the cap, queue new work. Archived rows are ignored."""
import json, re, sys

def bad(msg):
    print(json.dumps({"error": f"bad input: {msg}"})); sys.exit(2)

try:
    d = json.load(sys.stdin)
    rows, req = d["sessions"], d["request"]
    ticket, repo, kind = req["ticket"], req["repo"], req.get("type") or "Ticket"
    active = int((d.get("caps") or {}).get("active", 3))
except (ValueError, KeyError, TypeError) as e:
    bad(e)
TYPES = {"Ticket": "🍸", "Skill": "🔧", "Cleanup": "🧹"}   # as in bouncer-title
if not ticket or not repo or active < 1 or kind not in TYPES:
    bad(f"ticket, repo, caps.active >= 1 and a type of {'|'.join(TYPES)} are required")

def title_identity(title):
    icon, _, rest = title.partition(" ")
    if icon in TYPES.values():
        idle_prefix = "[Idle] "
        name = rest[len(idle_prefix):] if rest.startswith(idle_prefix) else ""
        # A second bracket and a name mean Idle is the ticket key.
        return icon, name if name and not re.match(r"\[[^\]]+\] .+", name) else None
    legacy = re.fullmatch(r"\[([^\]]+)\]\s+(\S+)(?:\s+(.*))?", title)
    if legacy:
        status, icon, rest = legacy.groups()
        if icon in TYPES.values():
            words = (rest or "").split()
            return icon, words[-1] if status == "Idle" and len(words) in (1, 2) else None
    return None, None

busy = 0
free = None
for session in rows:
    if session.get("isArchived"):
        continue
    title = session.get("title") or ""
    icon, name = title_identity(title.lstrip("!"))
    if not icon:
        continue
    if name is None or title.startswith("!") or session.get("isRunning"):
        busy += 1
    elif free is None and name == repo and icon == TYPES[kind]:
        free = session
if busy >= active:
    out = {"action": "queue", "reason": f"pool full: {busy} of {active} Bartenders active"}
elif free is not None:
    out = {"action": "assign", "sessionId": free["sessionId"], "reason": f"idle {kind} Bartender in {repo}"}
else:
    out = {"action": "start", "reason": f"no idle {kind} Bartender in {repo}; {busy} of {active} active"}
print(json.dumps(out))
