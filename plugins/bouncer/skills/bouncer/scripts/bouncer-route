#!/usr/bin/env python3
"""bouncer-route < {"sessions": [list_sessions rows], "request": {"ticket", "repo", "type"?}, "caps": {"active": 3}}
Out: {"action": "assign"|"start"|"queue", "sessionId"?: id, "reason": text}. Exit 2: bad input.
Rules: a Bartender title contains its type emoji (Ticket 🍸, the default; Skill 🔧; Cleanup 🧹).
Idle: the title is "<emoji> [Idle] <repo>" (before plugin 0.10.5 "[Idle] <emoji> <repo>") and isRunning is not true; the repo
is its last word. An idle Bartender of the same type and repo gets the work;
else a new Bartender starts (one per ticket, so tickets of one repo run in parallel).
At most caps.active non-idle Bartenders (default 3). Archived rows are ignored."""
import json, sys

def bad(msg):
    print(json.dumps({"error": f"bad input: {msg}"})); sys.exit(2)

try:
    d = json.load(sys.stdin)
    rows, req = d["sessions"], d["request"]
    ticket, repo, kind = req["ticket"], req["repo"], req.get("type") or "Ticket"
    active = int((d.get("caps") or {}).get("active", 3))
except (ValueError, KeyError, TypeError) as e:
    bad(e)
TYPES = {"Ticket": "🍸", "Skill": "🔧", "Cleanup": "🧹"}   # as in bouncer-title
if not ticket or not repo or active < 1 or kind not in TYPES:
    bad(f"ticket, repo, caps.active >= 1 and a type of {'|'.join(TYPES)} are required")

def idle(s):
    # A `!` title has a question that waits on the user: never free, in either title format.
    title = s.get("title") or ""
    return not title.startswith("!") and "[Idle]" in title.split()[:2] and not s.get("isRunning")

def emoji(s):
    words = (s.get("title") or "").lstrip("!").split()
    return next((w for w in words[:2] if w in TYPES.values()), None)

bars = [s for s in rows if emoji(s) and not s.get("isArchived")]
here = [s for s in bars if s["title"].split()[-1] == repo and emoji(s) == TYPES[kind]]
busy = [s for s in bars if not idle(s)]
free = [s for s in here if idle(s)]
if free:
    out = {"action": "assign", "sessionId": free[0]["sessionId"], "reason": f"idle {kind} Bartender in {repo}"}
elif len(busy) >= active:
    out = {"action": "queue", "reason": f"pool full: {len(busy)} of {active} Bartenders active"}
else:
    out = {"action": "start", "reason": f"no idle {kind} Bartender in {repo}; {len(busy)} of {active} active"}
print(json.dumps(out))
