#!/usr/bin/env python3
"""bouncer-ledger add "<kind> | <key> | <trigger> | <check> | <note>"   add an open item; prints its id (L1, L2, ...)
bouncer-ledger done <id>   remove a settled item (exit 1 when there is no such id)
bouncer-ledger due         run each item's check; print the items that are due (exit 0 either way)
bouncer-ledger list        print the open items
The ledger is ledger.md in the plugin's data folder (bouncer-data), one line an item:
  <id> | <kind> | <key> | <trigger> | <check> | <added YYYY-MM-DD> | <note>
kind: pr, held-message, follow-up, verify. key: a PR URL or a ticket key. The note may hold "|"; the other fields may not.
check: a shell command that exits 0 when the item is due and 1 when it is not. Empty for a pr: due when
`gh pr view <key>` says MERGED or CLOSED. Empty for another kind: never due by itself (the Bouncer checks it by hand).
A check that exits with another code, or times out after 60 s, prints "unsure <line>" on stderr.
Exit 2: bad usage, an unknown kind, or a line without a kind and a key."""
import datetime, os, re, subprocess, sys

KINDS = ("pr", "held-message", "follow-up", "verify")

def die(msg, code=2):
    print(msg, file=sys.stderr); sys.exit(code)

data = subprocess.run([os.path.join(os.path.dirname(os.path.realpath(__file__)), "bouncer-data")],
                      capture_output=True, text=True, check=True).stdout.strip()
path = os.path.join(data, "ledger.md")
lines = [l for l in (open(path).read().splitlines() if os.path.exists(path) else []) if l.strip()]

def fields(line):
    return [f.strip() for f in line.split("|", 6)]

def save(rows):
    with open(path, "w") as f: f.write("".join(r + "\n" for r in rows))

a = sys.argv[1:]
cmd = a[0] if a else ""
if cmd == "add" and len(a) == 2:
    parts = [f.strip() for f in a[1].split("|", 4)] + [""] * 5
    kind, key, trigger, check, note = parts[:5]
    if kind not in KINDS: die(f"unknown kind: {kind!r} (want {', '.join(KINDS)})")
    if not key: die("bad line: want kind | key | trigger | check | note")
    if kind == "pr" and not trigger: trigger = "merged or closed"
    n = max([int(m.group(1)) for l in lines if (m := re.match(r"L(\d+) ", l))] + [0]) + 1
    today = os.environ.get("BOUNCER_TODAY") or datetime.date.today().isoformat()
    lines.append(" | ".join([f"L{n}", kind, key, trigger, check, today, note]))
    save(lines); print(f"L{n}")
elif cmd == "done" and len(a) == 2:
    keep = [l for l in lines if fields(l)[0] != a[1]]
    if len(keep) == len(lines): die(f"no item {a[1]}", 1)
    save(keep)
elif cmd == "list" and len(a) == 1:
    for l in lines: print(l)
elif cmd == "due" and len(a) == 1:
    for l in lines:
        _, kind, key, _, check, *_ = fields(l) + [""] * 7
        if not check and kind == "pr":
            check = f"s=$(gh pr view {key!r} --json state -q .state) || exit 2; [ \"$s\" = MERGED ] || [ \"$s\" = CLOSED ]"
        if not check: continue
        try: code = subprocess.run(["bash", "-c", check], capture_output=True, timeout=60).returncode
        except subprocess.TimeoutExpired: code = -1
        if code == 0: print(l)
        elif code != 1: print(f"unsure {l}", file=sys.stderr)
else:
    die("usage: bouncer-ledger add|done|due|list [line|id]")
