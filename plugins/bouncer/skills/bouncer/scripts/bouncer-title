#!/usr/bin/env python3
"""bouncer-title <status> <ticket> <repo> [--cta] [--type T]   ->  [<code>] 🍸 <ticket> <repo>  (! prefix with --cta)
bouncer-title --idle <repo> [--type T]                        ->  [Idle] 🍸 <repo>
--type picks the emoji: Ticket 🍸 (default), Skill 🔧, Cleanup 🧹. For Skill and Cleanup, <ticket> is a short task name.
bouncer-title --bouncer <n>                        ->  !<n> 🚪 Bouncer, or 🚪 Bouncer at 0
Status codes come from BOUNCER_STATUS_CODES ("Name=Code; Name=Code"), else from the status_codes plugin option
stored in Claude Code's settings.json, else from the option default in the plugin manifest.
Exit 2: bad input, a bad code pair or an unknown status."""
import json, os, sys

TYPES = {"Ticket": "🍸", "Skill": "🔧", "Cleanup": "🧹"}   # the band, bouncer-route and Rounds parse these titles
BOUNCER = "🚪 Bouncer"

def die(msg):
    print(msg, file=sys.stderr); sys.exit(2)

def stored_option():
    # The model may leave out BOUNCER_STATUS_CODES, so read the option where Claude Code stores it.
    path = os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude"), "settings.json")
    try: configs = json.load(open(path)).get("pluginConfigs", {})
    except (OSError, ValueError): return ""
    return next((str(v.get("options", {}).get("status_codes", "")) for k, v in configs.items() if k.startswith("bouncer@")), "")

def codes():
    raw = os.environ.get("BOUNCER_STATUS_CODES", "").strip() or stored_option().strip()
    if not raw:   # the option is unset: use its default from the plugin manifest
        manifest = os.path.join(os.path.dirname(os.path.realpath(__file__)), "../../../.claude-plugin/plugin.json")
        raw = json.load(open(manifest))["userConfig"]["status_codes"]["default"]
    out = {}
    for pair in filter(None, (p.strip() for p in raw.split(";"))):
        name, eq, code = (s.strip() for s in pair.partition("="))
        if not (name and eq and code): die(f"bad status code pair: {pair!r} (want Name=Code)")
        out[name] = code
    return out

a = sys.argv[1:]
kind = "Ticket"
if "--type" in a:
    i = a.index("--type")
    if i + 1 >= len(a) or a[i + 1] not in TYPES: die(f"usage: --type {'|'.join(TYPES)}")
    kind = a[i + 1]; del a[i:i + 2]
BARTENDER = TYPES[kind]
if a[:1] == ["--idle"]:
    if len(a) != 2 or not a[1]: die("usage: bouncer-title --idle <repo>")
    print(f"[Idle] {BARTENDER} {a[1]}"); sys.exit(0)
if a[:1] == ["--bouncer"]:
    if len(a) != 2 or not a[1].isdigit(): die("usage: bouncer-title --bouncer <n>  (n >= 0)")
    n = int(a[1]); print(f"!{n} {BOUNCER}" if n else BOUNCER); sys.exit(0)
cta = "--cta" in a
a = [x for x in a if x != "--cta"]
if len(a) != 3 or not all(a): die("usage: bouncer-title <status> <ticket> <repo> [--cta]")
status, ticket, repo = a
code = codes().get(status)
if not code: die(f"unknown status: {status} (add it to the status_codes plugin option)")
print(f"{'!' if cta else ''}[{code}] {BARTENDER} {ticket} {repo}")
