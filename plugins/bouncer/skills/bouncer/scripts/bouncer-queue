#!/usr/bin/env bash
# bouncer-queue add "<TICKET> | <repo> | <mode> | <brief source>"   add, or replace the line of the same ticket
# bouncer-queue pop    print the first line and remove it (exit 1 when the queue is empty)
# bouncer-queue remove <TICKET>   remove the line of that ticket (exit 1 when no line has it)
# bouncer-queue list   print the queue
# The queue is queue.md in this Bouncer's repo folder of the plugin's data (bouncer-data --repo); BOUNCER_REPO=<repo> picks another repo's.
# Exit 2: bad usage or a line that is not 4 fields with a mode Code, Spike or Mechanical.
set -euo pipefail
trim() { local s=$1; s=${s#"${s%%[![:space:]]*}"}; printf '%s' "${s%"${s##*[![:space:]]}"}"; }   # not xargs: it fails on quotes
cmd=${1:-}
[ -n "$cmd" ] || { echo "usage: bouncer-queue add|pop|remove|list [line|ticket]" >&2; exit 2; }
f="$("$(dirname "$0")/bouncer-data" --repo)/queue.md"
touch "$f"
case $cmd in
  add)
    line=${2:-}
    IFS='|' read -r t r m b x <<<"$line"
    t=$(trim "$t"); r=$(trim "$r"); m=$(trim "$m"); b=$(trim "${b:-}")
    [ -n "$t" ] && [ -n "$r" ] && [ -n "$b" ] && [ -z "${x:-}" ] || { echo "bad line: want TICKET | repo | mode | brief source" >&2; exit 2; }
    case $m in Code|Spike|Mechanical) ;; *) echo "bad mode: $m (Code, Spike, Mechanical)" >&2; exit 2;; esac
    tmp=$(mktemp); grep -v "^$t |" "$f" > "$tmp" || true   # a stale line of the same ticket is replaced
    echo "$t | $r | $m | $b" >> "$tmp"; mv "$tmp" "$f" ;;
  pop)
    [ -s "$f" ] || { echo "queue empty" >&2; exit 1; }
    head -n 1 "$f"; tmp=$(mktemp); tail -n +2 "$f" > "$tmp"; mv "$tmp" "$f" ;;
  remove)
    t=$(trim "${2:-}"); [ -n "$t" ] || { echo "usage: bouncer-queue remove <TICKET>" >&2; exit 2; }
    grep -q "^$t |" "$f" || { echo "not in the queue: $t" >&2; exit 1; }
    tmp=$(mktemp); grep -v "^$t |" "$f" > "$tmp" || true; mv "$tmp" "$f" ;;
  list) cat "$f" ;;
  *) echo "usage: bouncer-queue add|pop|remove|list [line|ticket]" >&2; exit 2 ;;
esac
